{
  "info": {
    "name": "FarmeORT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección del proyecto con registro público, sesiones y regresión de altas administrativas. Configurar baseUrl y adminContrasena en un environment local; adminEmail corresponde al administrador precargado. Ejecutar completa con Collection Runner o Newman. El login administrativo salta a Usuarios; su último caso vuelve al logout administrativo y termina la ejecución. Los ids, emails, nicknames y tokens se generan durante el run. No exportar credenciales ni tokens reales."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5088"
    },
    {
      "key": "registroEmail",
      "value": ""
    },
    {
      "key": "registroNickname",
      "value": ""
    },
    {
      "key": "fechaCumple13",
      "value": ""
    },
    {
      "key": "fechaMenor13",
      "value": ""
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "playerToken",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@farmeort.com",
      "type": "string"
    },
    {
      "key": "adminContrasena",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminAltaEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminAltaNickname",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminUsuarioId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Jugadores",
      "item": [
        {
          "name": "Registro público → 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufijo = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 16);",
                  "pm.collectionVariables.set(\"registroEmail\", \"registro.\" + sufijo + \"@farmeort.test\");",
                  "pm.collectionVariables.set(\"registroNickname\", \"jug\" + sufijo);",
                  "const hoy = new Date();",
                  "const cumple13 = new Date(hoy.getFullYear() - 13, hoy.getMonth(), hoy.getDate());",
                  "const fechaLocal = d => [d.getFullYear(), String(d.getMonth() + 1).padStart(2, \"0\"), String(d.getDate()).padStart(2, \"0\")].join(\"-\");",
                  "pm.collectionVariables.set(\"fechaCumple13\", fechaLocal(cumple13));",
                  "const menor = new Date(cumple13); menor.setDate(menor.getDate() + 1);",
                  "pm.collectionVariables.set(\"fechaMenor13\", fechaLocal(menor));",
                  "pm.collectionVariables.set(\"adminAltaEmail\", \"admin.alta.\" + sufijo + \"@farmeort.test\");",
                  "pm.collectionVariables.set(\"adminAltaNickname\", \"org\" + sufijo);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const jugador = pm.response.json();",
                  "pm.test(\"Jugador con ELO inicial\", () => { pm.expect(jugador.rol).to.eql(\"Jugador\"); pm.expect(jugador.elo).to.eql(1200); pm.expect(jugador.id).to.be.above(0); });",
                  "pm.test(\"Sin secretos ni sesión\", () => { pm.expect(jugador).not.to.have.property(\"contrasena\"); pm.expect(jugador).not.to.have.property(\"contrasenaHash\"); pm.expect(jugador).not.to.have.property(\"token\"); });",
                  "pm.test(\"Location del usuario\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/v1/usuarios/\" + jugador.id));",
                  "pm.collectionVariables.set(\"playerId\", jugador.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jugadores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "jugadores"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Pérez\",\n  \"email\": \"{{registroEmail}}\",\n  \"nickname\": \"{{registroNickname}}\",\n  \"contrasena\": \"ClaveSegura123!!\",\n  \"fechaNacimiento\": \"2000-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
