@startuml
hide circle
title Detalle del torneo: clases que participan (D-44)

package FarmeORT.DTOs {
  class TorneoResponse {
    + Id : int
    + Codigo : string
    + Estado : string
    + InscripcionesAceptadas : int
    + Organizador : string
  }
  class TorneoDetalleResponse {
    + SkillsObligatorias : IReadOnlyList<SkillResponse>
    + JugadoresAceptados : IReadOnlyList<JugadorAceptadoResponse>
  }
  class SkillResponse {
    + Id : int
    + Codigo : string
    + Nombre : string
    + Categoria : string
    + Dificultad : int
    + Activa : bool
  }
  class JugadorAceptadoResponse {
    + JugadorId : int
    + Nickname : string
    + Elo : int
  }
}

package FarmeORT.Servicios {
  class ServicioTorneos {
    + ObtenerPorId(id : int, esAnonimo : bool) : TorneoDetalleResponse
    - CrearJugadorAceptado(inscripcion : Inscripcion) : JugadorAceptadoResponse
  }
  class RespuestasSkills <<static>> {
    + Crear(skill : Skill) : SkillResponse
  }
}

package FarmeORT.IRepositorios {
  interface IRepositorioTorneos {
    + ObtenerPorId(id : int) : Torneo
  }
  interface IRepositorioInscripciones {
    + ListarAceptadasDelTorneo(torneoId : int) : IReadOnlyList<Inscripcion>
  }
}

TorneoResponse <|-- TorneoDetalleResponse
TorneoDetalleResponse --> "0..2" SkillResponse
TorneoDetalleResponse --> "0..*" JugadorAceptadoResponse
ServicioTorneos ..> IRepositorioTorneos : <<use>>
ServicioTorneos ..> IRepositorioInscripciones : <<use>>
ServicioTorneos ..> RespuestasSkills : <<use>>
ServicioTorneos ..> TorneoDetalleResponse : <<create>>
@enduml
