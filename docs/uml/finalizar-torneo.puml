@startuml
title Finalizar torneo (D-64, D-63)
actor "Organizador o Administrador" as U
participant ":FinalizacionesController" as C
participant ":ServicioFinalizaciones" as S
participant ":RepositorioTorneos" as RT
participant ":RepositorioBatallas" as RB
participant ":RepositorioInscripciones" as RI
participant "torneo:Torneo" as T
database ":FarmeORTContext" as Ctx

U -> C : POST /api/v1/torneos/{torneoId}/finalizaciones\nAuthorization: Bearer {token}
note over C : Autorizacion exige token válido y rol Organizador o Administrador.
C -> S : Finalizar(torneoId, usuarioId, rol)
S -> RT : ObtenerPorId(torneoId)
RT --> S : torneo
alt torneo inexistente
  S --> C : TorneoNoEncontradoException
  C --> U : 404 TOURNAMENT_NOT_FOUND
else Organizador que no es el asignado
  S --> C : NoEsOrganizadorDelTorneoException
  C --> U : 403 NOT_TOURNAMENT_ORGANIZER
else organizador asignado o Administrador
  S -> RB : ListarSinResolverDelTorneo(torneoId)
  RB --> S : batallas Pendientes o En arbitraje
  alt hay batallas sin resolver
    S --> C : TorneoConBatallasSinResolverException
    C --> U : 409 TOURNAMENT_HAS_UNRESOLVED_BATTLES
  else todas resueltas
    S -> RI : ListarAceptadasDelTorneo(torneoId)
    RI --> S : jugadores sin eliminar
    alt no queda exactamente uno
      S --> C : TorneoSinCampeonException
      C --> U : 409 TOURNAMENT_WITHOUT_CHAMPION
    else queda uno: el campeón
      S -> T : Finalizar(campeon)
      alt no está En curso
        T --> S : TorneoNoEnCursoException
        S --> C : excepción
        C --> U : 409 TOURNAMENT_NOT_IN_PROGRESS
      else En curso
        T --> S : estado Finalizado, CampeonId
        S -> RT : Actualizar(torneo)
        RT -> Ctx : SaveChanges()
        Ctx --> RT : ok
        S --> C : FinalizacionResponse (torneoId, estado, campeon)
        C --> U : 200 FinalizacionResponse
      end
    end
  end
end
@enduml
