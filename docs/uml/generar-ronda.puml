@startuml
title Generar ronda — primera y siguientes, guardado atómico (D-62, D-63)
actor "Organizador o Administrador" as U
participant ":RondasController" as C
participant ":ServicioRondas" as S
participant ":RepositorioTorneos" as RT
participant ":RepositorioInscripciones" as RI
participant ":RepositorioBatallas" as RB
participant "torneo:Torneo" as T
participant ":IEstrategiaEmparejamiento" as E
participant "batalla:Batalla" as B
database ":FarmeORTContext" as Ctx

U -> C : POST /api/v1/torneos/{torneoId}/rondas\nAuthorization: Bearer {token}
note over C : Autorizacion exige token válido y rol Organizador o Administrador.
C -> S : Generar(torneoId, usuarioId, rol)
S -> RT : ObtenerPorId(torneoId)
RT --> S : torneo
alt torneo inexistente
  S --> C : TorneoNoEncontradoException
  C --> U : 404 TOURNAMENT_NOT_FOUND
else Organizador que no es el asignado
  S --> C : NoEsOrganizadorDelTorneoException
  C --> U : 403 NOT_TOURNAMENT_ORGANIZER
else organizador asignado o Administrador
  S -> RI : ListarAceptadasDelTorneo(torneoId)
  RI --> S : inscripciones Aceptadas (los que siguen)
  alt torneo no está En curso (primera ronda)
    S -> T : Iniciar(aceptadas)
    alt no está Abierto
      T --> S : TorneoNoAbiertoException
      S --> C : excepción
      C --> U : 409 TOURNAMENT_NOT_OPEN
    else aceptadas < cupo
      T --> S : TorneoIncompletoException
      S --> C : excepción
      C --> U : 409 TOURNAMENT_NOT_FULL
    else
      T --> S : estado En curso (numero = 1)
    end
  else torneo En curso (ronda siguiente)
    S -> RB : ListarDelTorneo(torneoId)
    RB --> S : batallas ordenadas por ronda e id
    alt no tiene batallas (sería la primera ronda)
      S --> C : TorneoNoAbiertoException
      C --> U : 409 TOURNAMENT_NOT_OPEN
    else la última ronda tiene batallas sin resolver
      S --> C : RondaSinResolverException
      C --> U : 409 ROUND_NOT_RESOLVED
    else queda un solo jugador
      S --> C : TorneoListoParaFinalizarException
      C --> U : 409 TOURNAMENT_READY_TO_FINISH
    else
      note over S : numero = última ronda + 1
    end
  end
  S -> E : Emparejar(jugadores)
  E --> S : pares (ELO de mayor a menor, desempate por id,\nmejor contra peor)
  loop cada par
    S -> B ** : new Batalla(torneo, numero, jugador1, jugador2, sorteo)
  end
  S -> RB : GuardarRonda(torneo, batallas)
  RB -> Ctx : SaveChanges()
  note right of Ctx
    Un solo SaveChanges guarda las batallas nuevas
    y el estado del torneo: quedan juntos o no queda nada.
  end note
  Ctx --> RB : ok
  S --> C : RondaResponse
  C --> U : 201 RondaResponse\nLocation: /api/v1/torneos/{torneoId}/rondas/{numero}
end
@enduml
