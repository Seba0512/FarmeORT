@startuml
hide circle
title Diseño propuesto — Persona B, fase 1
class Batalla {
  + Id : int
  + TorneoId : int
  + NumeroRonda : int
  + Jugador1Id : int
  + Jugador2Id : int
  + Estado : EstadoBatalla
  + JugadorInicialId : int
  + JugadorTurnoId : int?
  + Batalla(torneo : Torneo, numeroRonda : int, jugador1 : Usuario, jugador2 : Usuario, sorteo : ISorteo)
  + Lanzar(jugador : Usuario, skill : Skill, fecha : DateTimeOffset) : Lanzamiento
  + Cancelar() : void
}
enum EstadoBatalla {
  Pendiente
  EnArbitraje
  Finalizada
  Cancelada
}
class Lanzamiento {
  + Id : int
  + BatallaId : int
  + Turno : int
  + JugadorId : int
  + SkillId : int
  + Fecha : DateTimeOffset
}
interface ISorteo {
  + ElegirEntre(jugador1 : Usuario, jugador2 : Usuario) : Usuario
}
class SorteoAleatorio
class Torneo
class Usuario
class Skill
class "Fallo (fase 2 pendiente)" as Fallo
Batalla "0..*" --> "1" Torneo
Batalla "0..*" --> "1" Usuario : jugador1
Batalla "0..*" --> "1" Usuario : jugador2
Batalla "1" *-- "0..8" Lanzamiento
Batalla "1" *-- "0..1" Fallo
Lanzamiento "0..*" --> "1" Usuario : jugador
Lanzamiento "0..*" --> "1" Skill
Batalla ..> ISorteo : constructor, solo empate
SorteoAleatorio ..|> ISorteo
note right of Fallo
  Diseño futuro, no implementado en fase 1.
  Requiere Inscripcion e ICalculadorElo en develop.
end note
@enduml
