@startuml
hide circle
title Persona B — batallas, lanzamientos y fallo
class Batalla {
  + Id : int
  + TorneoId : int
  + NumeroRonda : int
  + Jugador1Id : int
  + Jugador2Id : int
  + Estado : EstadoBatalla
  + JugadorInicialId : int
  + JugadorTurnoId : int?
  + GanadorId : int?
  + Comentario : string?
  + CambioEloJugador1 : int?
  + CambioEloJugador2 : int?
  + Batalla(torneo : Torneo, numeroRonda : int, jugador1 : Usuario, jugador2 : Usuario, sorteo : ISorteo)
  + Lanzar(jugador : Usuario, skill : Skill, fecha : DateTimeOffset) : Lanzamiento
  + Cancelar() : void
  + ValidarFallo(ganadorId : int, comentario : string?) : void
  + Fallar(ganadorId : int, comentario : string?, cambioEloJugador1 : int, cambioEloJugador2 : int) : void
}
enum EstadoBatalla {
  Pendiente
  EnArbitraje
  Finalizada
  Cancelada
}
class Lanzamiento {
  + Id : int
  + BatallaId : int
  + Turno : int
  + JugadorId : int
  + SkillId : int
  + Fecha : DateTimeOffset
  + Lanzamiento(batalla : Batalla, turno : int, jugador : Usuario, skill : Skill, fecha : DateTimeOffset)
}
interface ISorteo {
  + ElegirEntre(jugador1 : Usuario, jugador2 : Usuario) : Usuario
}
class SorteoAleatorio
class Torneo
class Usuario {
  + Elo : int
  + ActualizarElo(elo : int) : void
}
class Skill
Batalla "0..*" --> "1" Torneo : torneo
Batalla "0..*" --> "1" Usuario : jugador1
Batalla "0..*" --> "1" Usuario : jugador2
Batalla "1" *-- "0..8" Lanzamiento : lanzamientos
Batalla "0..*" --> "0..1" Usuario : ganador
Lanzamiento "0..*" --> "1" Usuario : jugador
Lanzamiento "0..*" --> "1" Skill : skill
Batalla ..> ISorteo : constructor, solo empate
SorteoAleatorio ..|> ISorteo
note right of Batalla
  Fallo opcional embebido como propiedades (D-53).
  Finalizada tiene ganador, comentario y cambios ELO.
  Los cambios ELO preservan el resultado histórico.
end note
@enduml
