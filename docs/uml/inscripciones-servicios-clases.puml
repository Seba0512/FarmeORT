@startuml
hide circle
skinparam classAttributeIconSize 0
title Servicios de inscripciones, skills obligatorias y repertorio (D-38, D-40, D-41)

package FarmeORT.WebAPI {
  class InscripcionesController
  class SkillsObligatoriasController
  class RepertorioController
}

package FarmeORT.IServicios {
  interface IServicioInscripciones {
    + Inscribir(jugadorId : int, request : InscripcionRequest) : InscripcionResponse
    + Listar(filtro : FiltroInscripcionesRequest, usuarioId : int, rol : string) : IReadOnlyList<InscripcionResponse>
    + ObtenerPorId(id : int, usuarioId : int, rol : string) : InscripcionResponse
    + Cancelar(id : int, jugadorId : int) : InscripcionResponse
  }
  interface IServicioSkillsObligatorias {
    + Listar(torneoId : int, esAnonimo : bool) : IReadOnlyList<SkillResponse>
    + Asociar(torneoId : int, request : SkillObligatoriaRequest, organizadorId : int) : SkillResponse
    + Quitar(torneoId : int, skillId : int, organizadorId : int) : void
  }
  interface IServicioRepertorio {
    + Listar(jugadorId : int) : IReadOnlyList<SkillDeclaradaResponse>
    + Declarar(jugadorId : int, request : SkillDeclaradaRequest) : SkillDeclaradaResponse
    + Quitar(jugadorId : int, skillId : int) : void
  }
}

package FarmeORT.Servicios {
  class ServicioInscripciones
  class ServicioSkillsObligatorias
  class ServicioRepertorio
}

package FarmeORT.IRepositorios {
  interface IRepositorioInscripciones {
    + ObtenerPorId(id : int) : Inscripcion
    + Listar(filtro : FiltroInscripciones) : IReadOnlyList<Inscripcion>
    + ExisteAceptada(torneoId : int, jugadorId : int) : bool
    + ContarAceptadas(torneoId : int) : int
    + ContarAceptadasPorTorneo(torneoIds : IReadOnlyCollection<int>) : IReadOnlyDictionary<int, int>
    + ListarAceptadasDelTorneo(torneoId : int) : IReadOnlyList<Inscripcion>
    + ListarAceptadasDelJugador(jugadorId : int) : IReadOnlyList<Inscripcion>
    + Agregar(inscripcion : Inscripcion) : void
    + Actualizar(inscripcion : Inscripcion) : void
  }
  interface IRepositorioTorneos {
    + ObtenerPorId(id : int) : Torneo
    + Actualizar(torneo : Torneo) : void
  }
  interface IRepositorioUsuarios {
    + ObtenerConRepertorio(id : int) : Usuario
    + GuardarRepertorio(jugador : Usuario) : void
  }
  interface IRepositorioSkills {
    + ObtenerPorId(id : int) : Skill
  }
}

InscripcionesController ..> IServicioInscripciones : <<use>>
SkillsObligatoriasController ..> IServicioSkillsObligatorias : <<use>>
RepertorioController ..> IServicioRepertorio : <<use>>

IServicioInscripciones <|.. ServicioInscripciones
IServicioSkillsObligatorias <|.. ServicioSkillsObligatorias
IServicioRepertorio <|.. ServicioRepertorio

ServicioInscripciones ..> IRepositorioInscripciones : <<use>>
ServicioInscripciones ..> IRepositorioTorneos : <<use>>
ServicioInscripciones ..> IRepositorioUsuarios : <<use>>
ServicioSkillsObligatorias ..> IRepositorioTorneos : <<use>>
ServicioSkillsObligatorias ..> IRepositorioSkills : <<use>>
ServicioSkillsObligatorias ..> IRepositorioInscripciones : <<use>>
ServicioRepertorio ..> IRepositorioUsuarios : <<use>>
ServicioRepertorio ..> IRepositorioSkills : <<use>>
ServicioRepertorio ..> IRepositorioInscripciones : <<use>>

note bottom of ServicioSkillsObligatorias
  Rechaza una obligatoria nueva si hay inscriptos Aceptados
  que no la tienen (PLAYERS_MISSING_MANDATORY_SKILL).
end note
note bottom of ServicioRepertorio
  No quita una skill que una inscripción vigente exige
  (Inscripcion.ExigeSkill → MANDATORY_SKILL_IN_USE).
end note
@enduml
