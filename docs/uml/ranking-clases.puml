@startuml
hide circle
title Ranking: clases que participan (D-61, D-45, D-46)

package FarmeORT.WebAPI {
  class RankingController {
    + Obtener(filtro : FiltroRankingRequest) : IActionResult
  }
}

package FarmeORT.IServicios {
  interface IServicioRanking {
    + Obtener(filtro : FiltroRankingRequest) : IReadOnlyList<JugadorRankingResponse>
  }
}

package FarmeORT.Servicios {
  class ServicioRanking {
    + Obtener(filtro : FiltroRankingRequest) : IReadOnlyList<JugadorRankingResponse>
    - ListarJugadores(torneoId : int?, cantidad : int) : IReadOnlyList<Usuario>
    - ValidarTorneoVisible(torneoId : int) : void
    - AjustarCantidad(cantidad : int) : int
  }
}

package FarmeORT.IRepositorios {
  interface IRepositorioUsuarios {
    + ListarRanking(cantidad : int) : IReadOnlyList<Usuario>
    + ListarRankingDelTorneo(torneoId : int, cantidad : int) : IReadOnlyList<Usuario>
  }
  interface IRepositorioTorneos {
    + ObtenerPorId(id : int) : Torneo
  }
  interface IRepositorioBatallas {
    + ContarResultadosPorJugador(jugadorIds : IReadOnlyCollection<int>, torneoId : int?) : IReadOnlyDictionary<int, ResultadosDeBatallas>
  }
  class ResultadosDeBatallas <<record>> {
    + Ganadas : int
    + Perdidas : int
  }
}

package FarmeORT.DTOs {
  class FiltroRankingRequest {
    + Cantidad : int
    + TorneoId : int?
  }
  class JugadorRankingResponse {
    + Posicion : int
    + Nickname : string
    + Elo : int
    + BatallasGanadas : int
    + BatallasPerdidas : int
  }
}

RankingController ..> IServicioRanking : <<use>>
IServicioRanking <|.. ServicioRanking
ServicioRanking ..> IRepositorioUsuarios : <<use>>
ServicioRanking ..> IRepositorioTorneos : <<use>>
ServicioRanking ..> IRepositorioBatallas : <<use>>
IRepositorioBatallas ..> ResultadosDeBatallas : <<create>>
ServicioRanking ..> JugadorRankingResponse : <<create>>
@enduml
