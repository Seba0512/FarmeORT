@startuml
hide circle
title Cancelar torneo — clases que participan (D-42)

package FarmeORT.IServicios {
  interface IServicioTorneos {
    + Cancelar(id : int) : TorneoResponse
  }
}

package FarmeORT.Servicios {
  class ServicioTorneos {
    + Cancelar(id : int) : TorneoResponse
  }
}

package FarmeORT.IRepositorios {
  interface IRepositorioTorneos {
    + ObtenerPorId(id : int) : Torneo
    + Actualizar(torneo : Torneo) : void
  }
  interface IRepositorioBatallas {
    + ListarSinResolverDelTorneo(torneoId : int) : IReadOnlyList<Batalla>
  }
  interface IRepositorioInscripciones {
    + ListarAceptadasDelTorneo(torneoId : int) : IReadOnlyList<Inscripcion>
  }
}

package FarmeORT.Dominio {
  class Torneo {
    + Estado : EstadoTorneo
    + Cancelar() : void
  }
  class Batalla {
    + Estado : EstadoBatalla
    + Cancelar() : void
  }
  class Inscripcion {
    + Estado : EstadoInscripcion
    + Cancelar() : void
  }
}

package FarmeORT.Repositorios {
  class RepositorioTorneos
  class RepositorioBatallas
  class RepositorioInscripciones
  class FarmeORTContext
}

IServicioTorneos <|.. ServicioTorneos
ServicioTorneos ..> IRepositorioTorneos : <<use>>
ServicioTorneos ..> IRepositorioBatallas : <<use>>
ServicioTorneos ..> IRepositorioInscripciones : <<use>>
IRepositorioTorneos <|.. RepositorioTorneos
IRepositorioBatallas <|.. RepositorioBatallas
IRepositorioInscripciones <|.. RepositorioInscripciones
RepositorioTorneos --> "1" FarmeORTContext
RepositorioBatallas --> "1" FarmeORTContext
RepositorioInscripciones --> "1" FarmeORTContext
Batalla "0..*" --> "1" Torneo
Inscripcion "0..*" --> "1" Torneo

note bottom of FarmeORTContext
  Scoped: una instancia por pedido, compartida por los tres
  repositorios. Un solo SaveChanges guarda todo o nada.
end note
@enduml
