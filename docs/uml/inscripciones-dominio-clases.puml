@startuml
hide circle
skinparam classAttributeIconSize 0
title Dominio de inscripciones, skills obligatorias y repertorio (D-38, D-40, D-41, D-43)

package FarmeORT.Dominio {
  package Inscripciones {
    class Inscripcion {
      + Id : int
      + TorneoId : int
      + JugadorId : int
      + Estado : EstadoInscripcion
      + Fecha : DateTime
      + EstaVigente : bool
      + Inscripcion(torneo : Torneo, jugador : Usuario, fecha : DateTime)
      + Cancelar() : void
      + Eliminar() : void
      + ExigeSkill(skillId : int) : bool
      - ValidarAceptada() : void
    }
    enum EstadoInscripcion {
      Aceptada
      Cancelada
      Eliminada
    }
  }

  package Torneos {
    class Torneo {
      + Id : int
      + Codigo : string
      + Cupo : int
      + Estado : EstadoTorneo
      + OrganizadorId : int
      + SkillsObligatorias : IReadOnlyCollection<Skill>
      + EsVisibleParaAnonimos : bool
      + Cancelar() : void
      + AsociarSkillObligatoria(skill : Skill) : void
      + QuitarSkillObligatoria(skillId : int) : void
    }
    enum EstadoTorneo {
      Abierto
      EnCurso
      Finalizado
      Cancelado
    }
  }

  package Usuarios {
    class Usuario {
      + Id : int
      + Nickname : string
      + Rol : Rol
      + Elo : int
      + Eliminado : bool
      + Repertorio : IReadOnlyCollection<SkillDeclarada>
      + DeclararSkill(skill : Skill, nivel : int, fechaActual : DateOnly) : SkillDeclarada
      + QuitarSkill(skillId : int) : void
      + SkillsFaltantes(requeridas : IEnumerable<Skill>) : IReadOnlyList<Skill>
    }
    class SkillDeclarada {
      + JugadorId : int
      + SkillId : int
      + Nivel : int
      + FechaDeclaracion : DateOnly
      + SkillDeclarada(jugador : Usuario, skill : Skill, nivel : int, fechaDeclaracion : DateOnly)
    }
  }

  package Skills {
    class Skill {
      + Id : int
      + Codigo : string
      + Activa : bool
    }
  }
}

Inscripcion "0..*" --> "1" Torneo : torneo
Inscripcion "0..*" --> "1" Usuario : jugador
Inscripcion ..> EstadoInscripcion
Torneo "0..*" --> "1" Usuario : organizador
Torneo "0..*" --> "0..2" Skill : skillsObligatorias
Torneo ..> EstadoTorneo
Usuario "1" *-- "0..*" SkillDeclarada : repertorio
SkillDeclarada "0..*" --> "1" Skill : skill

note bottom of Inscripcion
  El constructor exige el torneo Abierto y todas las
  obligatorias declaradas. Cancelada y Eliminada son finales.
  EstaVigente: Aceptada y torneo no Finalizado ni Cancelado.
end note
note bottom of Torneo
  Una obligatoria nueva tiene que estar activa (SKILL_INACTIVE)
  y el torneo Abierto; como máximo dos.
end note
@enduml
